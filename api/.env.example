# ===========================
# Aplicación
# ===========================
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS (separados por coma). Ej: el frontend admin.
CORS_ORIGIN=http://localhost:5173

# ===========================
# Base de datos PostgreSQL
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=kult
# Sincroniza el esquema automáticamente (usar solo en desarrollo)
DB_SYNCHRONIZE=true
# Log de queries SQL en consola
DB_LOGGING=true
# Conexión SSL (activar en producción / nube)
DB_SSL=false

# ===========================
# Redis (uso futuro)
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here

# ===========================
# Autenticación (JWT)
# ===========================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# ===========================
# Usuario administrador inicial (seed)
# ===========================
ADMIN_EMAIL=admin@kult.local
ADMIN_PASSWORD=changeme123

# ===========================
# Sudomock
# ===========================
# Cuenta única (compatibilidad). Se registra como cuenta "default".
SUDOMOCK_API_KEY=your_sudomock_api_key_here
# Varias cuentas (recomendado si el plan trial limita plantillas por cuenta).
# Formato: alias:apikey separados por coma. Tiene prioridad sobre SUDOMOCK_API_KEY.
# SUDOMOCK_ACCOUNTS=trial1:sk_aaa...,trial2:sk_bbb...
# Opcional: sobrescribe la URL base del SDK (default https://api.sudomock.com)
# SUDOMOCK_BASE_URL=https://api.sudomock.com

# ===========================
# Cloudinary (almacenamiento de imágenes)
# ===========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Carpeta destino en Cloudinary (opcional, default: kult/renders)
CLOUDINARY_FOLDER=kult/renders

# ===========================
# OpenRouter (generación de SEO con IA + embeddings)
# ===========================
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ===========================
# Marca / sitio (para SEO: structured data, Open Graph)
# ===========================
BRAND_NAME=Tu Marca
SITE_URL=https://tu-dominio.com

# ===========================
# Frontend admin (SPA servida por la propia API)
# ===========================
# Ruta al build del admin. En la imagen Docker se copia a dist/client, que
# es el valor por defecto; normalmente NO hace falta definir esta variable.
# CLIENT_DIST_PATH=/app/dist/client